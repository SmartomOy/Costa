---
import Paw from './icons/Paw.astro';
import { steps } from '../data/site';
---

<section class="section process" data-process>
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Näin käynti etenee</p>
        <h2 class="h2" data-split>Rauhassa, <em>askel kerrallaan</em></h2>
      </div>
      <p class="lead" data-reveal>
        Ensimmäinen kerta jännittää usein sekä koiraa että omistajaa. Siksi jokainen käynti etenee
        tutusti ja koiran tahdissa.
      </p>
    </div>

    <ol class="steps">
      <span class="steps__track" aria-hidden="true">
        <span class="steps__fill" data-process-fill></span>
        <span class="steps__walker" data-process-walker><Paw /></span>
      </span>
      {
        steps.map((s, i) => (
          <li class="step" data-step>
            <span class="step__dot" aria-hidden="true">
              <span>{i + 1}</span>
            </span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    --dot: 56px;
    position: relative;
    display: grid;
    gap: 40px;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }

  .steps__track {
    position: absolute;
    left: calc(var(--dot) / 2);
    top: calc(var(--dot) / 2);
    bottom: calc(var(--dot) / 2);
    width: 1px;
    background: var(--line);
  }

  @media (min-width: 900px) {
    .steps__track {
      top: calc(var(--dot) / 2);
      bottom: auto;
      left: calc(var(--dot) / 2);
      /* päättyy viimeisen pallon keskelle: sarakkeen leveys = (100% - 3 × 32px) / 4 */
      right: calc(25% - 24px - var(--dot) / 2);
      width: auto;
      height: 1px;
    }
  }

  .steps__fill {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: top;
    transform: scaleY(0);
  }

  @media (min-width: 900px) {
    .steps__fill {
      transform-origin: left;
      transform: scaleX(0);
    }
  }

  :global(html:not(.js)) .steps__fill {
    transform: none;
  }

  .steps__walker {
    position: absolute;
    left: 50%;
    top: 0;
    width: 22px;
    translate: -50% -50%;
    color: var(--brown);
    opacity: 0;
    rotate: 180deg;
  }

  @media (min-width: 900px) {
    .steps__walker {
      left: 0;
      top: 50%;
      rotate: 90deg;
    }
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    grid-template-columns: var(--dot) 1fr;
    column-gap: 22px;
    row-gap: 8px;
  }

  @media (min-width: 900px) {
    .step {
      grid-template-columns: 1fr;
      row-gap: 14px;
    }
  }

  .step__dot {
    grid-row: span 2;
    position: relative;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--cream);
    border: 1px solid var(--ink);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-style: italic;
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  @media (min-width: 900px) {
    .step__dot {
      grid-row: auto;
      margin-bottom: 14px;
    }
  }

  :global(.is-active) .step__dot,
  :global(html:not(.js)) .step__dot {
    background: var(--ink);
    color: var(--cream);
  }

  .step__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.4rem + 0.8vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    align-self: center;
  }

  .step__text {
    color: var(--muted);
    max-width: 26em;
  }
</style>
