---
import Paw from './icons/Paw.astro';

const words = ['Pesu', 'Trimmaus', 'Saksitrimmaus', 'Nyppiminen', 'Kynnet', 'Pentukäynnit'];
---

<div class="marquee" aria-hidden="true" data-marquee>
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {words.map((w, i) => (
            <>
              <span class:list={['marquee__word', { 'marquee__word--outline': i % 2 === 1 }]}>{w}</span>
              <Paw class="marquee__paw" />
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    position: relative;
    padding-block: clamp(28px, 4vw, 52px);
    background: var(--cream-2);
    border-block: 1px solid var(--line);
    overflow: hidden;
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__group {
    display: flex;
    align-items: center;
    flex: none;
  }

  .marquee__word {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 6.2rem);
    font-weight: 400;
    line-height: 1.1;
    white-space: nowrap;
    padding-inline: clamp(18px, 2.4vw, 40px);
  }

  .marquee__word--outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--ink);
  }

  .marquee :global(.marquee__paw) {
    width: clamp(20px, 2.4vw, 34px);
    flex: none;
    color: var(--brown);
  }
</style>
