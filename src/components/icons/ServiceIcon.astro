---
import type { ServiceIcon } from '../../data/site';

interface Props {
  name: ServiceIcon;
}
const { name } = Astro.props;
---

<svg
  class="service-icon"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'bath' && (
      <>
        <path d="M8 24h32v4a10 10 0 0 1-10 10H18A10 10 0 0 1 8 28v-4z" />
        <path d="M14 38l-2 4M34 38l2 4" />
        <path d="M12 24V11a4 4 0 0 1 7.5-2" />
        <circle cx="25" cy="13" r="2.6" />
        <circle cx="31" cy="8.5" r="1.8" />
        <circle cx="32" cy="17" r="1.4" />
      </>
    )
  }
  {
    name === 'clipper' && (
      <>
        <path d="M18 6h12l2 8v22a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6V14l2-8z" />
        <path d="M18 6v-1M22 6V4M26 6V4M30 6v-1" />
        <path d="M16 14h16" />
        <rect x="21" y="20" width="6" height="9" rx="3" />
      </>
    )
  }
  {
    name === 'scissors' && (
      <>
        <circle cx="13" cy="35" r="6" />
        <circle cx="35" cy="35" r="6" />
        <path d="M17.5 31 38 6M30.5 31 10 6" />
        <circle cx="24" cy="22.5" r="0.8" fill="currentColor" />
      </>
    )
  }
  {
    name === 'hand' && (
      <>
        <path d="M16 26V12a2.5 2.5 0 0 1 5 0v10" />
        <path d="M21 22V9a2.5 2.5 0 0 1 5 0v13" />
        <path d="M26 22V11a2.5 2.5 0 0 1 5 0v12" />
        <path d="M31 23v-7a2.5 2.5 0 0 1 5 0v13c0 7-5 13-12 13h-1c-5 0-8-3-10.5-7L9 28a2.6 2.6 0 0 1 4-3.2l3 3.2" />
      </>
    )
  }
  {
    name === 'paw' && (
      <>
        <ellipse cx="12" cy="21" rx="3.8" ry="5" transform="rotate(-18 12 21)" />
        <ellipse cx="19.5" cy="12.5" rx="4" ry="5.4" transform="rotate(-6 19.5 12.5)" />
        <ellipse cx="28.5" cy="12.5" rx="4" ry="5.4" transform="rotate(6 28.5 12.5)" />
        <ellipse cx="36" cy="21" rx="3.8" ry="5" transform="rotate(18 36 21)" />
        <path d="M24 24c-5.2 0-10.5 6.7-10.5 11.9 0 3.6 2.8 5.6 6 5.6 2 0 3.1-1 4.5-1s2.5 1 4.5 1c3.2 0 6-2 6-5.6C34.5 30.7 29.2 24 24 24z" />
      </>
    )
  }
  {
    name === 'heart' && (
      <>
        <path d="M24 40S8 30.5 8 19a8 8 0 0 1 16-2 8 8 0 0 1 16 2c0 11.5-16 21-16 21z" />
        <path d="M17.5 20.5a3.5 3.5 0 0 1 3.5-3.5" />
      </>
    )
  }
</svg>
